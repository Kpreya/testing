      <nav>
        <a href="#" class="nav-item">
          <span>📊</span>
          <span>Dashboard</span>
        </a>
        <a href="#" class="nav-item active">
          <span>🚨</span>
          <span>Issues</span>
        </a>
        <a href="#" class="nav-item">
          <span>📈</span>
          <span>Reports</span>
        </a>
        <a href="#" class="nav-item">
