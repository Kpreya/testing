                <div class="assignee">
                  <div class="assignee-avatar">MR</div>
                  <span class="assignee-name">Mike Ross</span>
                </div>
              </td>
              <td class="timestamp">15 min ago</td>
              <td>
                <button class="action-btn">View</button>
              </td>
            </tr>
            
            <tr>
              <td>
                <div class="issue-id">
                  <div class="issue-status-dot high"></div>
                  <div>
                    <div class="issue-code">ISS-1232</div>
                    <div class="issue-title">Memory leak in WebSocket connection handler</div>
                  </div>
                </div>
              </td>
              <td>
                <span class="priority-badge high">High</span>
              </td>
              <td class="stat-cell">892</td>
              <td class="stat-cell">456</td>
              <td>
                <div class="assignee">
