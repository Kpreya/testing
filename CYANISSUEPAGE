                  <span class="assignee-name">Alex Kim</span>
                </div>
              </td>
              <td class="timestamp">1 hour ago</td>
              <td>
                <button class="action-btn">View</button>
              </td>
            </tr>
            
            <tr>
              <td>
                <div class="issue-id">
                  <div class="issue-status-dot medium"></div>
                  <div>
                    <div class="issue-code">ISS-1231</div>
                    <div class="issue-title">Slow database query on user dashboard</div>
