          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="pagination">
        <div class="pagination-info">
          Showing <strong>1-10</strong> of <strong>248</strong> issues
        </div>
        <div class="pagination-controls">
          <button class="page-btn" disabled>‹</button>
