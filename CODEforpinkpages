              >

                {item.icon}

              </span>

              {!collapsed && (

                <span className="font-medium truncate">{item.name}</span>

              )}

              {isActive && !collapsed && (

                <div className="ml-auto w-1.5 h-1.5 rounded-full bg-[#7c3aed]" />

