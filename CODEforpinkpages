      >

        {collapsed ? (

          <ChevronRightIcon className="w-4 h-4" />

        ) : (

          <ChevronLeftIcon className="w-4 h-4" />

        )}

      </button>

      {/* User section */}

      <div className="p-4 border-t border-[rgba(124,58,237,0.2)]">

