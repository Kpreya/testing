<!DOCTYPE html>
<html lang="en" dir="ltr" style="overflow:auto;" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SynapseFlow - Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', sans-serif;
      background: #09090b;
      color: #ffffff;
      line-height: 1.5;
    }
    
    .app-container {
      display: flex;
      min-height: 100vh;
    }
    
    /* Sidebar */
    .sidebar {
      width: 240px;
      background: #09090b;
      border-right: 1px solid #27272a;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
    }
    
    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 32px;
      padding: 0 8px;
    }
    
    .logo-icon {
      width: 32px;
      height: 32px;
      background: #06b6d4;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
    }
    
    .logo-text {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
    }
    
    .nav-item {
      padding: 10px 12px;
      margin-bottom: 4px;
      border-radius: 6px;
      color: #a1a1aa;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: all 0.2s;
      border-left: 2px solid transparent;
    }
    
    .nav-item:hover {
      background: #18181b;
      color: #ffffff;
    }
    
    .nav-item.active {
      background: rgba(6, 182, 212, 0.1);
      color: #06b6d4;
      border-left-color: #06b6d4;
    }
    
    /* Main Content */
    .main-content {
      flex: 1;
      padding: 32px;
      overflow-y: auto;
    }
    
    /* Alert Banner */
    .alert-banner {
      background: linear-gradient(135deg, rgba(220, 38, 38, 0.1), rgba(239, 68, 68, 0.05));
      border: 1px solid #dc2626;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 32px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    
    .alert-icon {
      width: 48px;
      height: 48px;
      background: rgba(220, 38, 38, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ef4444;
      flex-shrink: 0;
    }
    
    .alert-content {
      flex: 1;
    }
    
    .alert-title {
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 4px;
    }
    
    .alert-description {
      font-size: 14px;
      color: #a1a1aa;
    }
    
    .alert-actions {
      display: flex;
      gap: 12px;
    }
    
    /* Buttons */
    .btn {
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    
    .btn-primary {
      background: #06b6d4;
      color: white;
    }
    
    .btn-primary:hover {
      background: #0891b2;
    }
    
    .btn-secondary {
      background: #27272a;
      color: #ffffff;
      border: 1px solid #3f3f46;
    }
    
    .btn-secondary:hover {
      background: #3f3f46;
    }
    
    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 32px;
    }
    
    .metric-card {
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 12px;
      padding: 20px;
      transition: all 0.2s;
    }
    
    .metric-card:hover {
      border-color: #06b6d4;
      box-shadow: 0 0 0 1px rgba(6, 182, 212, 0.1);
    }
    
    .metric-label {
      font-size: 13px;
      color: #a1a1aa;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    
    .metric-value {
      font-size: 32px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
    }
    
    .metric-change {
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    
    .metric-change.positive {
      color: #10b981;
    }
    
    .metric-change.negative {
      color: #ef4444;
    }
    
    /* Funnel Chart */
    .funnel-container {
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 32px;
    }
    
    .funnel-header {
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 20px;
    }
    
    .funnel-step {
      margin-bottom: 16px;
    }
    
    .funnel-step-label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 14px;
    }
    
    .funnel-step-name {
      color: #ffffff;
    }
    
    .funnel-step-stats {
      color: #a1a1aa;
    }
    
    .funnel-bar-container {
      height: 32px;
      background: #27272a;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
    }
    
    .funnel-bar {
      height: 100%;
      background: linear-gradient(90deg, #06b6d4, #0891b2);
      border-radius: 6px;
      transition: width 0.3s ease;
      display: flex;
      align-items: center;
      padding: 0 12px;
      color: white;
      font-size: 13px;
      font-weight: 600;
    }
    
    .funnel-bar.warning {
      background: linear-gradient(90deg, #ef4444, #dc2626);
    }
    
    /* Issues List */
    .issues-list {
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 12px;
      padding: 24px;
    }
    
    .issues-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    
    .issues-title {
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
    }
    
    .issue-item {
      padding: 16px;
      background: #09090b;
      border: 1px solid #27272a;
      border-radius: 8px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: all 0.2s;
    }
    
    .issue-item:hover {
      border-color: #06b6d4;
    }
    
    .issue-badge {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    
    .issue-badge.critical {
      background: #ef4444;
      box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
    }
    
    .issue-badge.high {
      background: #f59e0b;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
    }
    
    .issue-content {
      flex: 1;
    }
    
    .issue-title {
      font-size: 14px;
      font-weight: 500;
      color: #ffffff;
      margin-bottom: 4px;
    }
    
    .issue-meta {
      font-size: 13px;
      color: #a1a1aa;
    }
    
    .issue-actions {
      display: flex;
      gap: 8px;
    }
    
    /* Responsive */
    @media (max-width: 1024px) {
      .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    
    @media (max-width: 768px) {
      .sidebar {
        display: none;
      }
      
      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo">
        <div class="logo-icon">⚡</div>
        <span class="logo-text">SynapseFlow</span>
      </div>
      
      <nav>
        <a href="#" class="nav-item active">
          <span>📊</span>
          <span>Dashboard</span>
        </a>
        <a href="#" class="nav-item">
          <span>🚨</span>
          <span>Issues</span>
        </a>
        <a href="#" class="nav-item">
          <span>📈</span>
          <span>Reports</span>
        </a>
        <a href="#" class="nav-item">
          <span>🎨</span>
          <span>Figma Review</span>
        </a>
        <a href="#" class="nav-item">
          <span>💻</span>
          <span>GitHub PR</span>
        </a>
        <a href="#" class="nav-item">
          <span>⚙️</span>
          <span>Settings</span>
        </a>
      </nav>
    </aside>
    
    <!-- Main Content -->
    <main class="main-content">
      <!-- Alert Banner -->
      <div class="alert-banner">
        <div class="alert-icon">⚠️</div>
        <div class="alert-content">
          <div class="alert-title">Critical: Conversion rate dropped 23% in the last 24 hours</div>
          <div class="alert-description">OTP Verification: 48% → 27% (-21 pts) • 2,847 users affected</div>
        </div>
        <div class="alert-actions">
          <button class="btn btn-primary">View Details</button>
          <button class="btn btn-secondary">Dismiss</button>
        </div>
      </div>
      
      <!-- Metrics Grid -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-label">Total Events</div>
          <div class="metric-value">1.2M</div>
          <div class="metric-change positive">
            <span>↑</span>
            <span>+12.5%</span>
          </div>
        </div>
        
        <div class="metric-card">
          <div class="metric-label">Error Rate</div>
          <div class="metric-value">3.2%</div>
          <div class="metric-change positive">
            <span>↓</span>
            <span>-0.8%</span>
          </div>
        </div>
        
        <div class="metric-card">
          <div class="metric-label">P95 Latency</div>
          <div class="metric-value">245ms</div>
          <div class="metric-change negative">
            <span>↑</span>
            <span>+18ms</span>
          </div>
        </div>
        
        <div class="metric-card">
          <div class="metric-label">Active Users</div>
          <div class="metric-value">48.2K</div>
          <div class="metric-change positive">
            <span>↑</span>
            <span>+5.3%</span>
          </div>
        </div>
      </div>
      
      <!-- Conversion Funnel -->
      <div class="funnel-container">
        <h2 class="funnel-header">Conversion Funnel</h2>
        
        <div class="funnel-step">
          <div class="funnel-step-label">
            <span class="funnel-step-name">Page View</span>
            <span class="funnel-step-stats">125,000 • 100%</span>
          </div>
          <div class="funnel-bar-container">
            <div class="funnel-bar" style="width: 100%">100%</div>
          </div>
        </div>
        
        <div class="funnel-step">
          <div class="funnel-step-label">
            <span class="funnel-step-name">Sign Up Click</span>
            <span class="funnel-step-stats">45,000 • 36%</span>
          </div>
          <div class="funnel-bar-container">
            <div class="funnel-bar" style="width: 36%">36%</div>
          </div>
        </div>
        
        <div class="funnel-step">
          <div class="funnel-step-label">
            <span class="funnel-step-name">Form Started</span>
            <span class="funnel-step-stats">28,000 • 22.4%</span>
          </div>
          <div class="funnel-bar-container">
            <div class="funnel-bar" style="width: 22.4%">22.4%</div>
          </div>
        </div>
        
        <div class="funnel-step">
          <div class="funnel-step-label">
            <span class="funnel-step-name">OTP Verification</span>
            <span class="funnel-step-stats">2,843 • 2.3% ⚠️</span>
          </div>
          <div class="funnel-bar-container">
            <div class="funnel-bar warning" style="width: 2.3%">2.3%</div>
          </div>
        </div>
      </div>
      
      <!-- Recent Issues -->
      <div class="issues-list">
        <div class="issues-header">
          <h2 class="issues-title">Recent Issues</h2>
          <a href="#" class="btn btn-secondary">View All</a>
        </div>
        
        <div class="issue-item">
          <div class="issue-badge critical"></div>
          <div class="issue-content">
            <div class="issue-title">ISS-1234 • TypeError: Cannot read property "map" of undefined</div>
            <div class="issue-meta">2,847 events • 2 min ago • Backend Team</div>
          </div>
          <div class="issue-actions">
            <button class="btn btn-primary">View</button>
            <button class="btn btn-secondary">Send to Slack</button>
          </div>
        </div>
        
        <div class="issue-item">
          <div class="issue-badge high"></div>
          <div class="issue-content">
            <div class="issue-title">ISS-1233 • API timeout on /api/checkout endpoint</div>
            <div class="issue-meta">1,523 events • 15 min ago • Growth Team</div>
          </div>
          <div class="issue-actions">
            <button class="btn btn-primary">View</button>
            <button class="btn btn-secondary">Send to Slack</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
